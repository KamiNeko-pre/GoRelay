# Generate distinct hex values: openssl rand -hex 24. Do not reuse demo examples.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
GORELAY_ADMIN_TOKEN=
GORELAY_RUNNER_TOKEN=
GORELAY_IMAGE_TAG=local
WORKERS=2
GORELAY_DEMO_DAILY_RUNS=20
# Paid API tasks need an explicit host policy. Defaults stay disabled.
# Fill a copy with verified prices and limits, then set both entries:
# GORELAY_SPEND_POLICY_FILE=./spend-policy.json
# GORELAY_SPEND_POLICY_PATH=/app/configs/spend-policy.json
GORELAY_SPEND_POLICY_FILE=../configs/agentbench/spend-policy.example.json
GORELAY_SPEND_POLICY_PATH=
GORELAY_RUN_MODEL_CALLS=12
GORELAY_RUN_SEARCH_CALLS=3
GORELAY_ACTION_MODE=code
# Experiment controls only; keep false for normal demonstrations.
GORELAY_DISABLE_CAPABILITY_REUSE=false
GORELAY_DISABLE_KNOWLEDGE_REUSE=false
GORELAY_INDEX_FORCE_REBUILD=false
# Local validation defaults. Server: bind=0.0.0.0, ports=80/443, site=your-domain.
GORELAY_BIND=127.0.0.1
GORELAY_HTTP_PORT=5088
GORELAY_HTTPS_PORT=5443
GORELAY_SITE_ADDRESS=http://:80
# Unselected providers stay empty. No fixture provider is substituted.
GORELAY_AI_BASE_URL=
GORELAY_AI_MODEL=
GORELAY_AI_API_KEY=
GORELAY_EMBED_BASE_URL=
GORELAY_EMBED_MODEL=
GORELAY_EMBED_API_KEY=
GORELAY_EMBED_DIMENSIONS=
GORELAY_SEARCH_API_KEY=
GORELAY_SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search
GORELAY_QDRANT_COLLECTION=gorelay
