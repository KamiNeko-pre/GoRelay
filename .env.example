# Copy this file to .env for the local Docker Compose demo.
# Use a local-only password that is safe for the MySQL DSN format.
MYSQL_ROOT_PASSWORD=change-this-local-password
WORKERS=8

# Optional AI adapters. Leave blank until choosing a provider; never commit keys.
# BASE_URL includes the provider API prefix (usually .../v1).
GORELAY_AI_BASE_URL=
GORELAY_AI_MODEL=
GORELAY_AI_API_KEY=
# Current DeepSeek V4.1 profile. Match these to the selected provider/model.
# Tokens, not bytes; frozen when a task is created.
GORELAY_AI_CONTEXT_WINDOW_TOKENS=1000000
GORELAY_AI_COMPACT_AT_TOKENS=500000
GORELAY_AI_COMPACT_TO_TOKENS=400000
GORELAY_AI_MAX_COMPLETION_TOKENS=384000
GORELAY_AI_REASONING_EFFORT=high
# Isolated execution resource budgets, shared by app and private runner.
# Each task freezes these; model input/output capacity is configured above.
GORELAY_PROGRAM_HTTP_REQUESTS=100
GORELAY_PROGRAM_MAX_BYTES=8388608
GORELAY_PROGRAM_MAX_ITEMS=1000
GORELAY_PROGRAM_MAX_OUTPUT_BYTES=2097152
# Optional LOCAL experiment transport; uses your existing Codex login/quota.
# Default stays openai-compatible HTTP. Codex is not an Embedding/search service.
GORELAY_AI_BACKEND=
GORELAY_CODEX_BIN=
# Must be supported by GORELAY_AI_MODEL; applies to decision and search transports.
GORELAY_CODEX_REASONING_EFFORT=low
GORELAY_CODEX_EVIDENCE_DIR=output/codex-inference
# CLI-only: private login/cache home; default is the OS user cache/GoRelay/codex-inference.
# Seeds auth.json from the current CLI login once; never copies AGENTS/skills/config.
# Keep this outside the project and evidence exports. API providers ignore it.
GORELAY_CODEX_HOME=
GORELAY_EMBED_BASE_URL=
GORELAY_EMBED_MODEL=
GORELAY_EMBED_API_KEY=
GORELAY_SEARCH_API_KEY=
# Default: brave. Public URL discovery without credentials: sogou_public_html.
GORELAY_SEARCH_BACKEND=brave
# Local CLI testing can use codex_cli here; searches are invoked by GoRelay.
GORELAY_CODEX_SEARCH_EVIDENCE_DIR=output/codex-search
# Local diagnostic only; freezes an unlimited Run budget while retaining usage
# accounting, cancellation, leases and per-operation sandbox limits.
GORELAY_EXPERIMENT_UNLIMITED_BUDGET=0
# Legacy finite-budget runs only. New crawler tasks use task time/spend limits;
# successful calls do not stop at these counts. Usage still accumulates.
GORELAY_RUN_MODEL_CALLS=12
GORELAY_RUN_SEARCH_CALLS=3
# Per-request timeout_seconds chooses the timebox for actual task difficulty.
# Zero disables the total task timebox; local IO timeouts and loop correction remain.
GORELAY_RUN_TIMEOUT=0s
GORELAY_INFORMATION_REQUEST_TIMEOUT=0s
GORELAY_BROWSER_MAX_FAILED_PLANS=3
GORELAY_BROWSER_ACTION_TIMEOUT=30s
# Container builds force production; CLI is rejected in this mode.
GORELAY_ENV=local
# Loop detection is independent of costs. Successful reads do not reset delivery
# progress; repeated semantic decisions trigger actionable delivery correction.
GORELAY_RUN_STAGNATION_CALLS=20
# Agent scheduling is owned by the separate agent-worker process.
GORELAY_AGENT_CONCURRENCY=2
# Optional trusted HTTP CONNECT proxy. Targets remain DNS-checked public IPs;
# HTTPS keeps source hostname certificate verification. Do not use HTTP_PROXY.
# Runner container must use a proxy address reachable from its own network.
GORELAY_ACQUISITION_PROXY=
# Native API task creation requires a host-owned spend policy. Leave empty for
# temporary CLI experiments; CLI has call limits, no trustworthy hard fee bound.
# Fill all limits/rates in configs/agentbench/spend-policy.example.json first.
GORELAY_SPEND_POLICY_PATH=
GORELAY_CHUNK_RUNES=600
GORELAY_CHUNK_OVERLAP=80
GORELAY_SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search
# Runner URL is private in Compose; token must be set before enabling the overlay.
GORELAY_RUNNER_URL=http://lua-runner:8091
GORELAY_RUNNER_TOKEN=
## Agent workbench mutations and paid model calls require this bearer token.
GORELAY_ADMIN_TOKEN=
GORELAY_QDRANT_URL=http://qdrant:6333
GORELAY_QDRANT_COLLECTION=gorelay
GORELAY_QDRANT_API_KEY=
GORELAY_EMBED_DIMENSIONS=
