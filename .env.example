# Local Docker Compose settings for GoRelay v2 (Zero-LLM MCP Runtime).
MYSQL_ROOT_PASSWORD=change-this-local-password
WORKERS=8

# Bearer tokens (generate via `openssl rand -hex 24` in shared environments).
GORELAY_ADMIN_TOKEN=local-dev-admin-token
GORELAY_RUNNER_TOKEN=local-dev-runner-token
GORELAY_RUNNER_URL=http://lua-runner:8091

# Governance & Sandbox controls.
GORELAY_RESPECT_ROBOTS=true
GORELAY_MAX_RESPONSE_BYTES=5242880
GORELAY_ACQUISITION_PROXY=
GORELAY_AUTH_PROFILES_JSON=
GORELAY_SNAPSHOT_DIR=/app/data/snapshots

# Optional external CDP/Browser sidecar for SPA XHR API sniffing (default empty = zero Chromium overhead).
GORELAY_BROWSER_CDP_URL=
GORELAY_BROWSER_CDP_TOKEN=

# Optional low-frequency canary verification for hot connectors used in last 14 days.
GORELAY_CANARY_ENABLED=false
GORELAY_ENV=local
