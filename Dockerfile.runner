FROM golang:1.26-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/lua-runner ./cmd/lua-runner

FROM alpine:3.21
RUN apk add --no-cache ca-certificates && addgroup -S runner && adduser -S runner -G runner
COPY --from=builder /out/lua-runner /app/lua-runner
USER runner
EXPOSE 8091
CMD ["/app/lua-runner", "-serve"]
